{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(task --list)",
      "Bash(task check:permissions)",
      "Bash(task checkout:check -- *)",
      "Bash(task ps)",
      "Bash(task logs)",
      "Bash(task logs -- *)",
      "Bash(task console -- about)",
      "Bash(task console -- debug*)",
      "Bash(task console -- lint*)",
      "Bash(task c -- about)",
      "Bash(task c -- debug*)",
      "Bash(task c -- lint*)",
      "Bash(task test)",
      "Bash(task test -- *)",
      "Bash(task phpunit)",
      "Bash(task phpunit -- *)",
      "Bash(task check)",
      "Bash(task cs)",
      "Bash(task cs -- *)",
      "Bash(task cs:check)",
      "Bash(task cs:check -- *)",
      "Bash(task stan)",
      "Bash(task stan -- *)",
      "Bash(task phpstan)",
      "Bash(task phpstan -- *)",
      "Bash(task rector:check)",
      "Bash(task dv)",
      "Bash(task dv -- *)",
      "Bash(task dms)"
    ],
    "ask": [
      "Bash(task dbr:*)",
      "Bash(task app:db:reset:*)",
      "Bash(task db:reset:*)",
      "Bash(task db:grant-test)",
      "Bash(task down)",
      "Bash(task app:down)"
    ],
    "deny": [
      "Bash(php:*)",
      "Bash(composer:*)",
      "Bash(bin/console:*)",
      "Bash(./bin/console:*)",
      "Bash(bin/phpunit:*)",
      "Bash(./bin/phpunit:*)",
      "Bash(vendor/bin/*)",
      "Bash(./vendor/bin/*)",
      "Bash(symfony:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose run:*)",
      "Bash(docker exec:*)",
      "Bash(docker-compose exec:*)",
      "Bash(docker-compose run:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr -* merge)",
      "Bash(gh pr -* merge *)",
      "Bash(gh api *pulls/*/merge)",
      "Bash(gh api *pulls/*/merge *)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *mergeBranch*)",
      "Bash(gh api *repos/*/merges*)",
      "Bash(gh api *git/refs/heads/master)",
      "Bash(gh api *git/refs/heads/master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * +master)",
      "Bash(git push * +master *)",
      "Bash(git push *refs/heads/master)",
      "Bash(git push *refs/heads/master *)",
      "Bash(gh api *git/refs/heads/main)",
      "Bash(gh api *git/refs/heads/main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -qE '(/Taskfile\\.yaml|/Taskfile\\.local\\.yml|/taskfiles/(common\\.yaml|permission-rules\\.json|permission-probes)|/\\.claude/settings(\\.local)?\\.json)$' || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && task check:permissions 1>&2 || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json\"; if command -v jq >/dev/null; then h=$(jq -r 'select(.disableAllHooks != true) | .hooks.PreToolUse[]? | select(.matcher == null or .matcher == \"\" or .matcher == \"*\" or .matcher == \"Bash\") | .hooks[]?.command | strings | capture(\"\\\\x27(?<p>[^\\\\x27]*check-permissions-hook\\\\.sh)\\\\x27\").p' \"$s\" 2>/dev/null | head -n 1); else h=$(grep -o \"'[^']*check-permissions-hook\\.sh'\" \"$s\" 2>/dev/null | head -n 1 | tr -d \"'\"); fi; [ -n \"$h\" ] && [ -f \"$h\" ] && exit 0; echo \"The permission check does not run in this account: $s does not run check-permissions-hook.sh before Bash commands, or its file is gone, so risky allow rules are not caught: install the shared tools again\" >&2; exit 1"
          }
        ]
      }
    ]
  }
}
