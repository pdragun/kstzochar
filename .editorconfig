# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml}]
indent_size = 2

[.github/**.yml]
indent_size = 2

[.claude/*.json]
indent_size = 2

[*.sh]
indent_style = tab

# Space-indented: its jq program is aligned with spaces
[taskfiles/check-permissions.sh]
indent_style = space

[{,*.*}Dockerfile]
indent_style = tab

[{,*.*}Caddyfile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
