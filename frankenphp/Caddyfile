{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	# Classic (non-worker) mode. The app no longer keeps static state between requests,
	# but it has not been tested in worker mode yet.
	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}
	}

	file_server {
		hide *.php
	}
}
