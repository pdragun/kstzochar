<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for entry in entries %}
    <url>
        <loc>{{ url(entry.route, entry.params) }}</loc>
{% if entry.lastmod %}
        <lastmod>{{ entry.lastmod|iso_timestamp }}</lastmod>
{% endif %}
    </url>
{% endfor %}
</urlset>
