<!doctype html>
<html lang="sk-SK">
<head>
    <meta charset="utf-8">
{# page_title is the child's title block without the trailing " - " separator; the block output is already escaped, so raw keeps trim() from escaping it again #}
{% set page_title %}{% apply trim(' -')|raw %}{% block title %}{% endblock %}{% endapply %}{% endset %}
{% set page_description %}{% block description %}{{ 'base.description'|trans }}{% endblock %}{% endset %}
{% set canonical_route = app.request.attributes.get('_route') %}
    <title>{% if page_title|length %}{{ page_title }} - {% endif %}{{ 'base.title'|trans }}</title>
    <meta name="description" content="{{ page_description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
{% if canonical_route %}
{# detail pages override canonical_url with the entry's own URL, because slugs match case-insensitively #}
{% set canonical_url %}{% block canonical_url %}{{ url(canonical_route, app.request.attributes.get('_route_params')) }}{% endblock %}{% endset %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:url" content="{{ canonical_url }}">
{% endif %}
    <meta property="og:site_name" content="{{ 'base.title'|trans }}">
    <meta property="og:locale" content="sk_SK">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{{ page_title|length ? page_title : 'base.title'|trans }}">
    <meta property="og:description" content="{{ page_description }}">
    <meta name="twitter:card" content="summary">
    {% block head %}{% endblock %}
    {% block stylesheets %}
        {{ encore_entry_link_tags('css/app') }}
    {% endblock %}
    <link rel="icon" type="image/svg+xml" href="{{ asset('build/images/favicon.svg') }}">
</head>
<body>
<div class="container">
    <div class="header">
        <div class="logo"><a href="{{ path('home_page') }}"><img src="{{ asset('build/images/kst-zochar_turista_logo.svg') }}" alt=""></a></div>
        <div class="logo-klub"><a href="{{ path('home_page') }}"><img src="{{ asset('build/images/kst-zochar_znak.svg') }}" alt=""></a></div>
        <div class="header-text">
            <p class="pt pt-long">{{ 'base.header1'|trans }}</p>
            <p class="pt pt-short">{{ 'base.header2'|trans }}</p>
            <p class="subtitle">{{ 'base.subtitle'|trans }}</p>
        </div>
    </div>
{% if homepage is not defined %}
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
                {{- knp_menu_render('main', {
                    'currentClass': 'active',
                    'ancestorClass': 'active',
                    'compressed': true,
                    'template': 'extended_knp_menu.html.twig'
                }) }}
        </nav>
{% endif %}

    <div class="wrapper">

        {%- if homepage is not defined %}
            {%- set breadcrumbs = knp_menu_get_breadcrumbs_array(knp_menu_get_current_item('main')) %}
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    {% for breadcrumb_item in breadcrumbs %}
                        {% if not loop.last %}
                            <li class="breadcrumb-item"><a href="{{ breadcrumb_item.uri }}">{{ breadcrumb_item.label }}</a></li>
                        {% else %}
                            <li class="breadcrumb-item active" aria-current="page">{{ breadcrumb_item.label }}</li>
                        {% endif %}
                    {% endfor %}
                </ol>
            </nav>
            <script type="application/ld+json">{{ breadcrumb_json_ld(breadcrumbs) }}</script>
        {%- endif %}


        {# important msg #}
        <p><b>Tlačivo pre <a href="https://kst.zochar.sk/blog/z-klubovej-kuchyne/2023/2-pre-KST-Zochar-2023">2% dane pre KST Žochár Topoľčany (2023)</a></b>.</p>
        {# read and display all flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
    <footer>
        <p class="no-bottom">{{ 'base.footer1'|trans }}</p>
        <p>{{ 'base.footer2'|trans }}</p>
        <p><a href="{{ path('cookies') }}">{{ 'cookies.footer'|trans }}</a>
            {%- if ga_measurement_id %} · <button type="button" class="btn btn-link" data-cookie-settings hidden>{{ 'cookies.settings'|trans }}</button>{% endif %}</p>
    </footer>
</div>
{% if ga_measurement_id %}
    {{ include('_cookie_consent.html.twig') }}
    {# outside the javascripts block, which some pages override without parent() #}
    {{ encore_entry_script_tags('cookieConsent') }}
{% endif %}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
