{% extends 'base.html.twig' %}

{% block title %}{{ blog.title }} - {% endblock %}
{% block description %}{{ blog.summary }}{% endblock %}
{% set blogUrl = url('blog_show_by_BlogSectionSlug_Year_Slug', {blogSectionSlug: blogSection.slug, year: year, slug: blog.slug}) %}
{% block head %}
    <script type="application/ld+json">{{ article_json_ld(blog, blogUrl) }}</script>
{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<hr>
<p>
    <a class="btn btn-primary btn-sm"
       href="{{ path('blog_create', {blogSectionSlug: blogSection.getSlug()}) }}"
       role="button"
    >Pridať nový článok</a>
    <a class="btn btn-primary btn-sm"
       href="{{ path('blog_edit', {blogSectionSlug: blogSection.getSlug(), year: year, slug: blog.getSlug()}) }}"
       role="button"
    >Upraviť tento</a>
    <a class="btn btn-danger btn-sm"
       href="{{ path('blog_delete', {blogSectionSlug: blogSection.getSlug(), year: year, slug: blog.getSlug()}) }}"
       role="button"
       data-bs-toggle="modal"
       data-bs-target="#delete"
    >Zmazať tento</a>
</p>
<hr>
<!-- Modal -->
<div class="modal fade" id="delete" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Naozaj zmazať?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavrieť"></button>
      </div>
      <div class="modal-body">
        Skutočne si želáte zmazať článok: "{{ blog.title }}"?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Nie!</button>
        <form class="d-inline" method="post" action="{{ path('blog_delete_yes', {blogSectionSlug: blogSection.getSlug(), year: year, slug: blog.getSlug()}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ blog.id) }}">
            <button type="submit" class="btn btn-danger">Chcem zmazať</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endif %}
<article class="h-entry">
    <h1 class="p-name">{{ blog.title }}</h1>
    <data class="u-url" value="{{ blogUrl }}"></data>
    <data class="p-summary" value="{{ blog.summary }}"></data>
    {{ include('_article_byline.html.twig', {article: blog}) }}
    <div class="e-content">
    {{ blog.content|raw }}
    </div>
</article>
{% endblock %}