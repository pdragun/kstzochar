{% extends 'base.html.twig' %}
{% block description %}{{ blog.summary }}{% endblock %}

{% block title %}{{ blog.title }} - {% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<hr>
<div>
    <a class="btn btn-secondary btn-sm" href="{{ path('blog_show_by_BlogSectionSlug_Year_Slug', {blogSectionSlug: blogSection.getSlug(), year: year, slug: blog.getSlug()}) }}" role="button">Nechcem zmazať</a>
    <form class="d-inline" method="post" action="{{ path('blog_delete_yes', {blogSectionSlug: blogSection.getSlug(), year: year, slug: blog.getSlug()}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ blog.id) }}">
        <button type="submit" class="btn btn-danger btn-sm">Chcem zmazať</button>
    </form>
</div>
<hr>

{% endif %}
    <h1>{{ blog.title }}</h1>
    {{ blog.content|raw }}
{% endblock %}